# ========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ========================================
# Copie este arquivo para .env e preencha com seus valores locais
# Comando: cp .env.example .env

# ========================================
# DATABASE
# ========================================
DB_PASSWORD=sua_senha_local
DB_URL=jdbc:postgresql://localhost:5432/ong-abcaa
DB_USER=postgres

# ========================================
# JWT SECRET
# ========================================
# Gerar com: openssl rand -base64 64
JWT_SECRET=seu-secret-local-desenvolvimento

# ========================================
# CERTIFICADO
# ========================================
CERTIFICATE_ORG_NAME=Associação Beneficiente e Cultural Amor em Ação
CERTIFICATE_ORG_CNPJ=54.794.100/0001-66
CERTIFICATE_ORG_CITY=Quitandinha
CERTIFICATE_ORG_STATE=PR

# ========================================
# ADMIN INICIAL
# ========================================
ADMIN_NAME=Administrador Local
ADMIN_EMAIL=admin@localhost.dev
ADMIN_PASSWORD=admin123

# ========================================
# LINK FRONTEND
# ========================================

CORS_ALLOWED_ORIGINS:link principal do frontend
URL_RESET_PASSWORD:link do frontend reset de senha de usuário

# ========================================
# EMAIL E SENHA DO EMAILSENDER PARA RESET DE SENHA
# ========================================

EMAIL:RESET_PASSWORD_VOLUNTEER: email que ira fazer o envio para conta dos usuarios
PASSWORD:RESET_PASSWORD_VOLUNTEER:sua senha de aplicativo, gerada pelo google